      "oculto": true
    },
    {
      "refId": "ci_combativo_r10e1_1",
      "nome": "Estilo de Luta",
      "tag": "classe",
      "efeitoHTML": "<p>Escolha <strong>um</strong> dos estilos abaixo:</p>\n<h4>Armeiro</h4>\n<ul>\n<li>Escolha <strong>1 tipo de Arma</strong> em <em>Artes da Guerra</em>.</li>\n<li>Recebe <strong>+1DR no Acerto</strong> com essa arma.</li>\n</ul>\n<h4>Lutador</h4>\n<ul>\n<li>Recebe <strong>+1DR</strong> em <strong>Ataques Desarmados</strong>.</li>\n<li>O <strong>Estágio de Dano</strong> do dado aumenta em <strong>+1</strong>.</li>\n</ul>\n<h4>Ninja</h4>\n<ul>\n<li>Recebe <strong>+1DR no Acerto</strong> com <strong>Ataques Desarmados</strong>.</li>\n<li>Caso esteja <strong>escondido</strong>, o Estágio de Dano aumenta em <strong>+2</strong>.</li>\n</ul>\n",
      "auto": true,
      "rank": 10,
      "estrela": 1
    },
